# Which publication this site shows, and where its store is.
REELRAIL_PUBLICATION=__PUBLICATION__

# json: the store file that reelrail writes. supabase: a publication_posts table.
REELRAIL_STORE_KIND=json
REELRAIL_STORE_PATH=__STORE_PATH__

# For the supabase store only. The site only reads, so use a read-only key.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# REELRAIL_TABLE=publication_posts
